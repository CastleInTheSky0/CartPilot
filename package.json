{
  "name": "duo-launch-assistant",
  "version": "2.1.0",
  "private": true,
  "description": "CartPilot 通用购买助手桌面应用",
  "author": "Sylvan",
  "main": "out/main/index.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "prebuild": "npm run check:lines",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --open",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "desktop:dev": "electron-vite dev",
    "desktop:check": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "desktop:build": "npm run check:lines && npm run desktop:check && electron-vite build",
    "desktop:start": "electron .",
    "desktop:package": "npm run desktop:build && electron-builder --win nsis --x64 --publish never",
    "desktop:verify-package": "pwsh -NoProfile -File scripts/verify-windows-package.ps1",
    "desktop:test": "tsx --test --test-concurrency=1 tests/unit/*.test.ts tests/packaging/*.test.ts",
    "desktop:test:storage": "node scripts/test-storage.mjs",
    "db:generate": "drizzle-kit generate",
    "check:lines": "node scripts/check-file-lines.mjs",
    "check:lines:strict": "node scripts/check-file-lines.mjs --strict",
    "browser:install": "playwright install chromium --no-shell"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "express": "^5.3.0",
    "lucide-react": "^1.57.0",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xstate": "5.33.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.0",
    "drizzle-kit": "0.31.11",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "prettier": "3.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
