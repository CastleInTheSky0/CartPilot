{
  "name": "duo-launch-assistant",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "prebuild": "npm run check:lines",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --open",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "check:lines": "node scripts/check-file-lines.mjs",
    "check:lines:strict": "node scripts/check-file-lines.mjs --strict",
    "browser:install": "playwright install chromium --no-shell"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.57.0",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
